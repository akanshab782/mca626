import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String[] name = new String[21];
        String[] gender = new String[21];
        String[] degree = new String[21];

        for (int i = 0; i < 21; i++) {
            System.out.println("Enter the student's name:");
            name[i] = sc.nextLine();

            System.out.println("Enter the student's gender(M/F):");
            gender[i] = sc.nextLine();

            System.out.println("Enter the student's degree (UG/PG):");
            degree[i] = sc.nextLine();
        }

        int room = 1;
        boolean[] allotted = new boolean[21];

        for (int i = 0; i < 21; i++) {
            if (allotted[i])
                continue;

            for (int j = i + 1; j < 21; j++) {
                if (!allotted[j] &&
                    gender[i].equalsIgnoreCase(gender[j])) {

                    System.out.println("\nRoom " + room + ":");
                    System.out.println(name[i] + " - " + degree[i]);
                    System.out.println(name[j] + " - " + degree[j]);

                    allotted[i] = true;
                    allotted[j] = true;
                    room++;
                    break;
                }
            }
        }

        System.out.println("\nStudents left without a roommate:");

        for (int i = 0; i < 21; i++) {
            if (!allotted[i]) {
                System.out.println(name[i] + " - "
                        + gender[i] + " - " + degree[i]);
            }
        }

        sc.close();
    }
}

